{
	"name": "terminal-portfolio",
	"version": "0.2.0",
	"private": true,
	"license": "MIT",
	"packageManager": "yarn@1.22.19",
	"engines": {
		"node": ">=20 <23",
		"yarn": ">=1.22.19 <2"
	},
	"scripts": {
		"dev": "next dev",
		"debug": "cross-env NEXT_PUBLIC_DEBUG=true next dev",
		"build": "next build",
		"start": "next start",
		"lint": "next lint",
		"typecheck": "tsc --noEmit",
		"format": "prettier --write . && eslint --fix .",
		"compile-resume-markdown": "node .bin/convert-resume-to-markdown.ts",
		"compile-resume-html": "node .bin/convert-resume-to-html.ts",
		"deploy": "git push heroku main",
		"test": "jest",
		"sync-env-vars": "bash .bin/sync-env-vars.sh",
		"cache:yarn": "yarn cache clean",
		"cache:next": "rm -rf .next",
		"cache:all": "yarn cache clean && rm -rf .next",
		"prepare": "husky"
	},
	"lint-staged": {
		"*.{js,jsx,ts,tsx}": [
			"eslint --fix",
			"prettier --write"
		],
		"*.{css,scss,md}": [
			"prettier --write"
		]
	},
	"dependencies": {
		"@opendocsg/pdf2md": "^0.1.31",
		"@react-three/drei": "^9.122.0",
		"@react-three/fiber": "^8.18.0",
		"@react-three/postprocessing": "^2.19.1",
		"@types/node": "^20.0.0",
		"@types/react": "^18.0.0",
		"@types/react-dom": "^18.0.0",
		"eslint-plugin-import": "^2.32.0",
		"next": "^15.4.3",
		"openai": "^4.54.0",
		"pdf-parse": "^1.1.1",
		"puppeteer": "^22.15.0",
		"r3f-perf": "^7.2.3",
		"react": "^18.0.0",
		"react-dom": "^18.0.0",
		"react-markdown": "^9.0.1",
		"sass": "^1.70.0",
		"three": "^0.170.0",
		"typescript": "^5.0.0"
	},
	"devDependencies": {
		"@swc/core": "^1.3.91",
		"@swc/jest": "^0.2.29",
		"@testing-library/dom": "^10.4.0",
		"@testing-library/jest-dom": "^6.6.3",
		"@testing-library/react": "^16.3.0",
		"@testing-library/user-event": "^14.6.1",
		"@types/jest": "^30.0.0",
		"@types/puppeteer": "^7.0.0",
		"@typescript-eslint/eslint-plugin": "^8.46.1",
		"@typescript-eslint/parser": "^8.46.1",
		"cross-env": "^10.1.0",
		"eslint": "^9.31.0",
		"eslint-config-next": "^15.4.3",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-prettier": "^5.5.4",
		"husky": "^9.1.7",
		"identity-obj-proxy": "^3.0.0",
		"ifdef-loader": "^2.3.2",
		"jest": "^30.0.4",
		"jest-environment-jsdom": "^30.0.4",
		"leva": "^0.10.0",
		"lint-staged": "^16.2.4",
		"prettier": "^3.6.2"
	}
}
